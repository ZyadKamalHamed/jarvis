# Copy to .env and fill what you have. The server reads this at startup.

# UTS Canvas personal access token (canvas.uts.edu.au > Account > Settings > Approved Integrations)
CANVAS_TOKEN=

# ElevenLabs for the JARVIS voice. Without it, macOS `say` is the fallback.
ELEVENLABS_API_KEY=
# Voice defaults to Daniel (composed British male). Swap for any voice ID you prefer.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# macOS fallback voice
SAY_VOICE=Daniel

# Outlook personal via Microsoft Graph (see bin/outlook.py header for the 5-minute setup)
OUTLOOK_CLIENT_ID=

# TrainHeroic (used by the unofficial exporter, optional)
TRAINHEROIC_EMAIL=
TRAINHEROIC_PASSWORD=

# Never put ANTHROPIC_API_KEY here. JARVIS runs claude -p on the subscription;
# an API key would silently switch billing to pay-as-you-go.
